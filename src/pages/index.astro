---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import CapacityStats from '../components/home/CapacityStats.astro';
import ServicesGrid from '../components/home/ServicesGrid.astro';
import CoverageBand from '../components/home/CoverageBand.astro';
import Certifications from '../components/home/Certifications.astro';
import DevisForm from '../components/home/DevisForm.astro';
import { organizationSchema, automotiveBusinessSchema, websiteSchema } from '../lib/schema';
import { agencePrincipale } from '../data/agences';
import { photos } from '../config/site';
---

<BaseLayout
  routeKey="home"
  preloadImage={photos.heroComedie}
  jsonLd={[organizationSchema(), automotiveBusinessSchema(agencePrincipale), websiteSchema()]}
>
  <TopNav routeKey="home" />
  <main id="main">
    <Hero />
    <CapacityStats />
    <ServicesGrid />
    <CoverageBand />
    <Certifications />
    <DevisForm />
  </main>
  <Footer />
</BaseLayout>
