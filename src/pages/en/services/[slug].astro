---
// Fiches services EN : /en/services/{slug}/
import LocalizedServiceDetailPage from '../../../components/i18n/LocalizedServiceDetailPage.astro';
import { getContent } from '../../../i18n';

export function getStaticPaths() {
  return getContent('en').services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<LocalizedServiceDetailPage locale="en" service={service} />
