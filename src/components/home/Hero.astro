---
import { site, photos } from '../../config/site';
import ReviewQr from './ReviewQr.astro';

const stats = [
  { value: '30+', label: "Années d'expérience", kicker: 'Entreprise familiale' },
  { value: '40', label: 'Plateaux de remorquage', kicker: 'Dont 4×4 et rabaissés' },
  { value: '4', label: 'Pays couverts', kicker: 'FR · BE · IT · ES' },
  { value: 'A9', label: 'Agréé autoroutes', kicker: 'Vinci partenaire' },
];
---

<section class="hero" style={`--hero-bg: url('${photos.heroComedie}');`}>
  <ReviewQr />

  <div class="hero-content">
    <div class="hero-pill">
      <span class="hero-pill-dot" aria-hidden="true"></span>
      Intervention 24H/24 · 7J/7
    </div>

    <h1 class="hero-title">
      Remorquage et dépannage,<br />
      <span class="hero-title-accent">24 heures sur 24.</span>
    </h1>

    <p class="hero-lead">
      Plus de 40 plateaux, véhicules 4×4, agréés autoroutes A9. Intervention en France,
      Belgique, Italie et Espagne. Voitures, poids lourds, véhicules de luxe.
    </p>

    <div class="hero-cta">
      <a href={site.phone.href} class="hero-phone" data-call-source="hero">
        <span class="hero-phone-icon" aria-hidden="true">☎</span>
        <span class="hero-phone-text">
          <span class="hero-phone-kicker">Urgence 24/7</span>
          <span class="hero-phone-number mono">{site.phone.display}</span>
        </span>
      </a>
      <a href="/depannage/" class="hero-quote">
        Où intervenons-nous&nbsp;?
        <span class="hero-quote-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="hero-reassure">
      <li><span class="hero-reassure-check" aria-hidden="true">✓</span> Certifié NF&nbsp;Service</li>
      <li><span class="hero-reassure-check" aria-hidden="true">✓</span> Agréé autoroutes A9</li>
      <li><span class="hero-reassure-check" aria-hidden="true">✓</span> Toutes assistances, sans avance de frais</li>
    </ul>
  </div>

  <div class="hero-trust">
    <ul class="hero-stats">
      {stats.map((s) => (
        <li class="hero-stat">
          <div class="hero-stat-value">{s.value}</div>
          <div class="hero-stat-label">{s.label}</div>
          <div class="hero-stat-kicker">{s.kicker}</div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(850px, calc(100svh - 76px));
    background-image:
      radial-gradient(ellipse at 12% 8%, rgba(62,127,44,0.34) 0%, transparent 48%),
      linear-gradient(90deg, rgba(18,50,17,0.9) 0%, rgba(26,25,15,0.54) 48%, rgba(26,25,15,0.16) 82%),
      linear-gradient(180deg, rgba(26,25,15,0.24) 0%, rgba(26,25,15,0.42) 48%, rgba(18,31,16,0.94) 100%),
      var(--hero-bg);
    background-size: cover;
    background-position: center 52%;
    color: #fff;
    padding: clamp(84px, 9vh, 112px) var(--pad-x-desktop) 42px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 52px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    width: 560px;
    height: 560px;
    right: -170px;
    top: -240px;
    border: 1px solid rgba(228,225,60,0.2);
    border-radius: 50%;
    box-shadow: 0 0 0 72px rgba(228,225,60,0.035), 0 0 0 144px rgba(228,225,60,0.02);
    pointer-events: none;
  }
  /* Voile lumineux subtil pour la profondeur */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 48% 112%, rgba(228,225,60,0.13) 0%, transparent 54%),
      linear-gradient(115deg, transparent 58%, rgba(255,255,255,0.04) 58.2%, transparent 58.5%);
    pointer-events: none;
    z-index: -1;
  }

  /* ---------- Animations d'entrée (au chargement) ---------- */
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: none; }
  }
  .hero-pill,
  .hero-title,
  .hero-lead,
  .hero-cta,
  .hero-reassure,
  .hero-trust {
    animation: hero-in 0.8s var(--ease-reveal) both;
  }
  .hero-title    { animation-delay: 0.08s; }
  .hero-lead     { animation-delay: 0.16s; }
  .hero-cta      { animation-delay: 0.24s; }
  .hero-reassure { animation-delay: 0.32s; }
  .hero-trust    { animation-delay: 0.40s; }
  @media (prefers-reduced-motion: reduce) {
    .hero-pill, .hero-title, .hero-lead, .hero-cta, .hero-reassure, .hero-trust {
      animation: none;
    }
  }

  .hero-content {
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 15px;
    background: rgba(238,235,55,0.95);
    border-radius: var(--radius-pill);
    color: var(--md-brand-black);
    margin-bottom: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }
  .hero-pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--md-brand-green);
    box-shadow: 0 0 0 3px rgba(44,97,38,0.25);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(58px, 6vw, 84px);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.035em;
    margin: 0 0 26px;
    max-width: 12.5ch;
    color: #fff;
    text-shadow: 0 8px 36px rgba(0,0,0,0.3);
  }
  .hero-title-accent { color: var(--md-brand-yellow); }

  .hero-lead {
    font-size: 18px;
    line-height: 1.65;
    max-width: 59ch;
    color: rgba(255,255,255,0.84);
    margin: 0 0 34px;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  /* ---------- Ligne de réassurance ---------- */
  .hero-reassure {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .hero-reassure li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.82);
  }
  .hero-reassure-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(228,225,60,0.9);
    color: var(--md-brand-black);
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .hero-phone {
    min-height: 62px;
    padding: 15px 25px;
    background: linear-gradient(135deg, #F0EC3A, var(--md-brand-yellow));
    color: var(--md-brand-black);
    border-radius: 15px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 12px 30px rgba(228,225,60,0.24);
    border: 1px solid rgba(255,255,255,0.3);
    transition: background-color var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  }
  .hero-phone:hover { background: var(--color-accent-hover); transform: translateY(-2px); box-shadow: 0 16px 34px rgba(228,225,60,0.31); }
  .hero-phone-icon { font-size: 22px; }
  .hero-phone-text { display: flex; flex-direction: column; }
  .hero-phone-kicker {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
    font-weight: 700;
  }
  .hero-phone-number {
    font-family: var(--font-mono);
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .hero-quote {
    min-height: 62px;
    padding: 15px 25px;
    background: rgba(255,255,255,0.1);
    color: #fff;
    border-radius: 15px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.28);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background-color var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }
  .hero-quote:hover { background: rgba(255,255,255,0.17); transform: translateY(-2px); }
  .hero-quote-arrow { opacity: 0.8; transition: transform var(--dur-base) var(--ease-standard); }
  .hero-quote:hover .hero-quote-arrow { transform: translateX(3px); }

  .hero-trust {
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
    padding: 10px;
    background: rgba(15, 37, 17, 0.52);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-card);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 22px 60px rgba(0,0,0,0.22);
    position: relative;
    z-index: 1;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .hero-stat {
    padding: 16px 22px;
    background: transparent;
    border: 0;
    border-right: 1px solid rgba(255,255,255,0.12);
    transition: background-color var(--dur-base) var(--ease-standard),
                border-color var(--dur-base) var(--ease-standard),
                transform var(--dur-base) var(--ease-standard);
  }
  .hero-stat:last-child { border-right: 0; }
  .hero-stat:hover {
    background: rgba(255,255,255,0.07);
    transform: translateY(-2px);
  }
  .hero-stat-value {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 700;
    color: var(--md-brand-yellow);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-stat-label {
    font-size: 13px;
    color: rgba(255,255,255,0.9);
    margin-top: 8px;
    font-weight: 600;
  }
  .hero-stat-kicker {
    font-size: 10px;
    color: rgba(255,255,255,0.55);
    margin-top: 2px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .hero { min-height: auto; padding: 82px var(--pad-x-tablet) 38px; }
    .hero-title { font-size: clamp(52px, 7vw, 66px); }
    .hero-stats { grid-template-columns: repeat(2, 1fr); }
    .hero-stat:nth-child(2) { border-right: 0; }
    .hero-stat:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.12); }
  }

  @media (max-width: 767px) {
    .hero {
      padding: 76px var(--pad-x-mobile) 28px;
      min-height: auto;
      background-position: 60% center;
      gap: 38px;
    }
    .hero::before { width: 320px; height: 320px; right: -170px; top: -160px; }
    .hero-pill { margin-bottom: 24px; font-size: 10px; padding: 8px 12px; }
    .hero-title { font-size: clamp(38px, 11vw, 48px); line-height: 1; margin-bottom: 20px; max-width: 100%; }
    .hero-lead { font-size: 16px; }
    .hero-cta { flex-direction: column; align-items: stretch; gap: 10px; margin-bottom: 30px; }
    .hero-phone, .hero-quote { width: 100%; justify-content: center; }
    .hero-phone-text { align-items: flex-start; }
    .hero-reassure { gap: 9px 14px; }
    .hero-reassure li { font-size: 12px; }
    .hero-trust { padding: 6px; border-radius: 18px; }
    .hero-stat { padding: 15px 13px; }
    .hero-stat-value { font-size: 32px; }
    .hero-stat-label { font-size: 12px; }
    .hero-stat-kicker { font-size: 9px; }
  }
</style>
