---
// Formulaire de demande de devis — section autonome de la home.
//
// Extrait de l'ancienne section « assistance » (carte verte retirée) : le
// discours « appelez d'abord votre assistance » a disparu, PAS le formulaire.
// Il alimente tout le pipeline commercial : POST /api/devis → D1 → email
// Resend → relance WhatsApp à 2 h → dashboards /admin et /pilotage.
//
// L'ancre `id="devis"` doit être préservée : la barre d'appel mobile et la
// redirection 301 `/devis` de public/_redirects pointent dessus.
import { site } from '../../config/site';
---

<section class="devis" aria-labelledby="devis-title">
  <div class="devis-inner">
    <div class="devis-intro">
      <div class="devis-section-overline">Devis</div>
      <h2 class="devis-section-title" id="devis-title">
        Pas d’urgence immédiate&nbsp;?<br />
        <span class="devis-section-accent">Demandez un devis.</span>
      </h2>
      <p class="devis-section-lead">
        Pour un remorquage programmé, un transport de véhicule ou une
        intervention à organiser, décrivez votre besoin&nbsp;: un dépanneur
        vous rappelle. Pour une panne en cours, appelez directement le
        <a href={site.phone.href} class="mono" data-call-source="devis-section">{site.phone.display}</a>.
      </p>
    </div>

    <div class="devis-panel" id="devis">
      <div class="devis-head">
        <div class="devis-overline">Demande de devis</div>
        <h3 class="devis-title">Décrivez votre besoin en quelques champs.</h3>
        <p class="devis-lead">
          Nous vous rappelons sous 2&nbsp;heures aux horaires ouvrés.
          Demande sans engagement, traitée par un dépanneur.
        </p>
        <p class="devis-lead-mail">
          Ou par email&nbsp;: <a href="mailto:pec@montpellierdepannage.com">pec@montpellierdepannage.com</a>
        </p>
      </div>

      <form class="devis-form" id="devis-form" novalidate>
        <div class="devis-grid">
          <label class="devis-field">
            <span class="devis-label">Nom &amp; prénom</span>
            <input type="text" name="name" autocomplete="name" maxlength="120" />
          </label>

          <label class="devis-field">
            <span class="devis-label">Téléphone <em class="req">*</em></span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              required
              maxlength="30"
              placeholder="06 12 34 56 78"
            />
          </label>

          <label class="devis-field">
            <span class="devis-label">Email</span>
            <input type="email" name="email" autocomplete="email" maxlength="160" />
          </label>

          <fieldset class="devis-field devis-field-radio">
            <legend class="devis-label">Type de véhicule</legend>
            <div class="devis-radios">
              <label><input type="radio" name="vehicle_type" value="VL" /> <span>VL</span></label>
              <label><input type="radio" name="vehicle_type" value="UTILITAIRE" /> <span>Utilitaire</span></label>
              <label><input type="radio" name="vehicle_type" value="PL" /> <span>Poids lourd</span></label>
            </div>
          </fieldset>

          <label class="devis-field devis-field-full">
            <span class="devis-label">Lieu de la panne</span>
            <input type="text" name="location" maxlength="200" placeholder="Adresse, sortie A9, lieu-dit…" />
          </label>

          <label class="devis-field devis-field-full">
            <span class="devis-label">Destination souhaitée</span>
            <input type="text" name="destination" maxlength="200" placeholder="Garage, domicile, adresse précise…" />
          </label>

          <label class="devis-field devis-field-full">
            <span class="devis-label">Détails</span>
            <textarea name="details" rows="3" maxlength="2000" placeholder="Marque/modèle, nature du problème, accès…"></textarea>
          </label>
        </div>

        <!-- honeypot anti-bot -->
        <div class="devis-honeypot" aria-hidden="true">
          <label>Site web (laisser vide)
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <label class="devis-consent">
          <input type="checkbox" name="consent_rgpd" required />
          <span>
            J’accepte que mes informations soient utilisées pour traiter ma demande de devis.
            Données conservées le temps du suivi commercial, jamais transmises à un tiers.
          </span>
        </label>

        <div class="devis-submit-row">
          <button type="submit" class="devis-submit">
            <span class="devis-submit-label">Envoyer la demande</span>
            <span class="devis-submit-spinner" aria-hidden="true"></span>
          </button>
          <span class="devis-submit-note">Réponse sous 2&nbsp;h aux heures ouvrées</span>
        </div>

        <div class="devis-result" role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('devis-form') as HTMLFormElement | null;
  if (form) {
    const result = form.querySelector<HTMLDivElement>('.devis-result')!;
    const submit = form.querySelector<HTMLButtonElement>('.devis-submit')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      result.textContent = '';
      result.className = 'devis-result';

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || ''),
        phone: String(data.get('phone') || ''),
        email: String(data.get('email') || ''),
        vehicle_type: String(data.get('vehicle_type') || ''),
        location: String(data.get('location') || ''),
        destination: String(data.get('destination') || ''),
        details: String(data.get('details') || ''),
        consent_rgpd: data.get('consent_rgpd') === 'on',
        website: String(data.get('website') || ''),
      };

      if (!payload.phone.trim()) {
        result.textContent = 'Merci d’indiquer un numéro de téléphone.';
        result.classList.add('devis-result-err');
        return;
      }
      if (!payload.consent_rgpd) {
        result.textContent = 'Merci d’accepter le traitement de vos données.';
        result.classList.add('devis-result-err');
        return;
      }

      submit.disabled = true;
      submit.classList.add('is-loading');

      try {
        const res = await fetch('/api/devis', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; debug?: string };
        if (!res.ok || !json.ok) {
          const detail = json.debug ? ` — ${json.debug}` : '';
          throw new Error(`${json.error || `HTTP ${res.status}`}${detail}`);
        }
        result.textContent = 'Demande envoyée. Nous vous rappelons sous 2 heures.';
        result.classList.add('devis-result-ok');
        form.reset();
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'erreur';
        result.textContent = `Échec de l’envoi (${msg}). Vous pouvez aussi appeler directement.`;
        result.classList.add('devis-result-err');
      } finally {
        submit.disabled = false;
        submit.classList.remove('is-loading');
      }
    });
  }
</script>

<style>
  /* ---------- Section ---------- */
  .devis {
    padding: 88px var(--pad-x-desktop);
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }
  .devis::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 12% 10%, rgba(44,97,38,0.05) 0%, transparent 55%),
      radial-gradient(ellipse at 88% 90%, rgba(228,225,60,0.08) 0%, transparent 55%);
    pointer-events: none;
  }
  .devis-inner {
    max-width: 860px;
    margin: 0 auto;
    position: relative;
  }
  .devis-intro { margin-bottom: 32px; }
  .devis-section-overline {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 18px;
  }
  .devis-section-title {
    font-family: var(--font-display);
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: var(--tr-display);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 14px;
  }
  .devis-section-accent { color: var(--color-primary); }
  .devis-section-lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 680px;
  }
  .devis-section-lead a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .devis-section-lead a:hover { text-decoration: underline; }

  /* ---------- Panneau ---------- */
  .devis-panel {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: 36px 36px 32px;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 20px;
  }
  .devis-head {
    margin-bottom: 24px;
  }
  .devis-overline {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 12px;
  }
  .devis-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--color-text);
    line-height: 1.2;
  }
  .devis-lead {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }
  .devis-lead-mail {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 8px 0 0;
  }
  .devis-lead-mail a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px dotted var(--color-primary);
  }
  .devis-lead-mail a:hover {
    border-bottom-style: solid;
  }

  .devis-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .devis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 16px;
  }
  .devis-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .devis-field-full { grid-column: 1 / -1; }
  .devis-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }
  .devis-label .req { color: var(--md-danger); font-style: normal; }
  .devis-field input[type='text'],
  .devis-field input[type='tel'],
  .devis-field input[type='email'],
  .devis-field textarea {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-text);
    background: var(--color-bg);
    transition: border-color var(--dur-base) var(--ease-standard),
                box-shadow var(--dur-base) var(--ease-standard);
  }
  .devis-field input:focus,
  .devis-field textarea:focus {
    outline: 0;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(44,97,38,0.12);
  }
  .devis-field textarea {
    resize: vertical;
    min-height: 80px;
    font-family: var(--font-sans);
  }

  .devis-radios {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .devis-radios label {
    flex: 1;
    min-width: 100px;
    cursor: pointer;
  }
  .devis-radios input[type='radio'] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .devis-radios span {
    display: block;
    text-align: center;
    padding: 11px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-bg);
    transition: border-color var(--dur-base) var(--ease-standard),
                background-color var(--dur-base) var(--ease-standard),
                color var(--dur-base) var(--ease-standard);
  }
  .devis-radios input[type='radio']:checked + span {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }
  .devis-radios input[type='radio']:focus-visible + span {
    box-shadow: 0 0 0 3px rgba(44,97,38,0.25);
  }

  .devis-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .devis-consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .devis-consent input {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    accent-color: var(--color-primary);
    flex-shrink: 0;
  }

  .devis-submit-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .devis-submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--color-primary);
    color: #fff;
    border: 0;
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease-standard),
                transform var(--dur-base) var(--ease-standard);
  }
  .devis-submit:hover { background: var(--color-primary-hover); }
  .devis-submit:active { transform: translateY(1px); }
  .devis-submit:disabled { opacity: 0.6; cursor: wait; }
  .devis-submit-spinner {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    display: none;
    animation: devis-spin 0.7s linear infinite;
  }
  .devis-submit.is-loading .devis-submit-spinner { display: inline-block; }
  @keyframes devis-spin { to { transform: rotate(360deg); } }
  .devis-submit-note {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .devis-result {
    font-size: 13px;
    line-height: 1.5;
    padding: 0;
  }
  .devis-result-ok {
    padding: 12px 14px;
    background: var(--color-primary-bg);
    color: var(--color-primary);
    border-radius: var(--radius-md);
    font-weight: 700;
  }
  .devis-result-err {
    padding: 12px 14px;
    background: var(--md-danger-bg);
    color: var(--md-danger);
    border-radius: var(--radius-md);
    font-weight: 700;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1023px) {
    .devis { padding: 72px var(--pad-x-tablet); }
    .devis-section-title { font-size: 30px; }
    .devis-panel { padding: 28px 24px; }
  }
  @media (max-width: 639px) {
    .devis { padding: 56px var(--pad-x-mobile); }
    .devis-section-title { font-size: 25px; }
    .devis-section-lead { font-size: 15px; }
    .devis-panel { padding: 24px 20px; }
    .devis-grid { grid-template-columns: 1fr; }
    .devis-title { font-size: 20px; }
    .devis-submit-row { flex-direction: column; align-items: stretch; }
    .devis-submit { justify-content: center; }
    .devis-submit-note { text-align: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .devis-submit { transition: none; }
  }
</style>
