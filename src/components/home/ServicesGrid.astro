---
import { services } from '../../data/services';

const cardImages: Record<string, string> = {
  porscheCayman: '/img/porsche-cayman-card.webp',
  plRecuperation: '/img/pl-recuperation-card.webp',
  interventionA9: '/img/intervention-a9-card.webp',
  transportInternational: '/img/transport-international-card.webp',
  flotteElectrique: '/img/flotte-electrique-card.webp',
  peyrou: '/img/peyrou-vertical-card.webp',
};

const cardImage = (photo: string) => cardImages[photo] ?? '/img/flotte-camions.webp';
---

<section class="services" id="services">
  <div class="services-inner">
    <header class="services-head" data-reveal>
      <div class="services-head-copy">
        <div class="services-overline">Nos activités</div>
        <h2 class="services-title">
          Un savoir-faire à votre service<br />pour chaque situation.
        </h2>
        <p class="services-lead">
          Du véhicule léger au poids lourd, en centre-ville comme sur l’A9 : une équipe et un matériel adaptés à chaque intervention.
        </p>
      </div>
      <a class="services-all" href="/services/">
        Tous nos services <span aria-hidden="true">→</span>
      </a>
    </header>

    <div class="services-grid">
      {services.map((s, i) => (
        <article class="service-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <a class="service-card-link-wrap" href={`/services/${s.slug}/`} aria-label={`${s.titre} — en savoir plus`}>
          <div class="service-card-img">
            <img
              src={cardImage(s.photo)}
              alt=""
              width="720"
              height="360"
              loading="lazy"
              decoding="async"
            />
            <span class="service-card-tag mono">{s.tag}</span>
          </div>
          <div class="service-card-body">
            <h3 class="service-card-title">{s.titre}</h3>
            <p class="service-card-desc">{s.resume}</p>
            <span class="service-card-more">Découvrir <span aria-hidden="true">→</span></span>
          </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--section-space) var(--pad-x-desktop);
    background:
      radial-gradient(circle at 92% 6%, rgba(228,225,60,0.12), transparent 25%),
      linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface-tint) 100%);
    position: relative;
  }
  .services-inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .services-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 46px;
    flex-wrap: wrap;
    gap: 20px;
  }
  .services-head-copy { max-width: 760px; }
  .services-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    display: inline-flex;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-bg);
  }
  .services-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 48px);
    margin: 0;
    color: var(--color-text);
    letter-spacing: var(--tr-display);
    line-height: 1.1;
    font-weight: 700;
  }
  .services-lead {
    max-width: 650px;
    margin-top: 16px;
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.65;
  }
  .services-all {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    padding: 12px 17px;
    border-radius: var(--radius-xl);
    box-shadow: 0 8px 22px rgba(44,97,38,0.18);
    transition: background-color var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }
  .services-all:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition: transform var(--dur-slow) var(--ease-standard), box-shadow var(--dur-slow) var(--ease-standard), border-color var(--dur-slow) var(--ease-standard);
  }
  .service-card-link-wrap {
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(44,97,38,0.24);
  }
  .service-card:focus-within { border-color: var(--color-primary); box-shadow: var(--shadow-card-hover); }
  .service-card-img {
    height: 205px;
    position: relative;
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .service-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 38%, rgba(18,50,17,0.62) 100%);
    pointer-events: none;
  }
  .service-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .service-card:hover .service-card-img img { transform: scale(1.055); }
  .service-card-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 8px;
    background: var(--md-brand-yellow);
    color: var(--md-brand-black);
    border-radius: var(--radius-pill);
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.05em;
    z-index: 1;
  }
  .service-card-body {
    padding: 23px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .service-card-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 8px;
    font-family: var(--font-display);
    line-height: 1.22;
  }
  .service-card-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }
  .service-card-link {
    margin-top: 16px;
    font-size: 12px;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .service-card-more {
    margin-top: 16px;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .service-card-more span {
    display: inline-grid;
    place-items: center;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: var(--color-primary-bg);
    transition: transform var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard);
  }
  .service-card:hover .service-card-more span { transform: translateX(3px); }
  .service-card-link span { transition: transform var(--dur-base) var(--ease-standard); }
  .service-card:hover .service-card-link span { transform: translateX(3px); }

  @media (max-width: 1023px) {
    .services { padding: 80px var(--pad-x-tablet); }
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .services-title { font-size: 32px; }
  }
  @media (max-width: 639px) {
    .services { padding: 68px var(--pad-x-mobile); }
    .services-grid { grid-template-columns: 1fr; }
    .services-title { font-size: 28px; }
    .services-lead { font-size: 15px; }
    .services-head { align-items: flex-start; margin-bottom: 32px; }
    .service-card-img { height: 190px; }
  }
</style>
