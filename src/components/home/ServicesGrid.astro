---
import { services } from '../../data/services';

const cardImages: Record<string, string> = {
  porscheCayman: '/img/porsche-cayman-card.webp',
  plRecuperation: '/img/pl-recuperation-card.webp',
  interventionA9: '/img/intervention-a9-card.webp',
  transportInternational: '/img/transport-international-card.webp',
  flotteElectrique: '/img/flotte-electrique-card.webp',
  peyrou: '/img/peyrou-vertical-card.webp',
};

const cardImage = (photo: string) => cardImages[photo] ?? '/img/flotte-camions.webp';
---

<section class="services" id="services">
  <div class="services-inner">
    <header class="services-head" data-reveal>
      <div>
        <div class="services-overline">Nos activités</div>
        <h2 class="services-title">
          Un savoir-faire à votre service<br />pour chaque situation.
        </h2>
      </div>
    </header>

    <div class="services-grid">
      {services.map((s, i) => (
        <article class="service-card" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <a class="service-card-link-wrap" href={`/services/${s.slug}/`} aria-label={`${s.titre} — en savoir plus`}>
          <div class="service-card-img">
            <img
              src={cardImage(s.photo)}
              alt=""
              width="720"
              height="360"
              loading="lazy"
              decoding="async"
            />
            <span class="service-card-tag mono">{s.tag}</span>
          </div>
          <div class="service-card-body">
            <h3 class="service-card-title">{s.titre}</h3>
            <p class="service-card-desc">{s.resume}</p>
            <span class="service-card-more">Découvrir <span aria-hidden="true">→</span></span>
          </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 80px var(--pad-x-desktop);
    background: var(--color-bg);
  }
  .services-inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .services-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
  }
  .services-overline {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 10px;
  }
  .services-title {
    font-family: var(--font-display);
    font-size: 40px;
    margin: 0;
    color: var(--color-text);
    letter-spacing: var(--tr-display);
    line-height: 1.1;
    font-weight: 700;
  }
  .services-all {
    font-size: 13px;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--color-border);
    padding: 10px 16px;
    border-radius: var(--radius-md);
    transition: background-color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard);
  }
  .services-all:hover {
    background: var(--color-primary-bg);
    border-color: var(--color-primary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard);
  }
  .service-card-link-wrap {
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .service-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .service-card-img {
    height: 160px;
    position: relative;
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .service-card-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(26,25,15,0.7) 100%);
    pointer-events: none;
  }
  .service-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .service-card:hover .service-card-img img { transform: scale(1.03); }
  .service-card-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 8px;
    background: var(--md-brand-yellow);
    color: var(--md-brand-black);
    border-radius: var(--radius-xs);
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.05em;
    z-index: 1;
  }
  .service-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .service-card-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 8px;
    font-family: var(--font-sans);
  }
  .service-card-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }
  .service-card-link {
    margin-top: 16px;
    font-size: 12px;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .service-card-more {
    margin-top: 16px;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .service-card-more span { display: inline-block; transition: transform var(--dur-base) var(--ease-standard); }
  .service-card:hover .service-card-more span { transform: translateX(3px); }
  .service-card-link span { transition: transform var(--dur-base) var(--ease-standard); }
  .service-card:hover .service-card-link span { transform: translateX(3px); }

  @media (max-width: 1023px) {
    .services { padding: 72px var(--pad-x-tablet); }
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .services-title { font-size: 32px; }
  }
  @media (max-width: 639px) {
    .services { padding: 56px var(--pad-x-mobile); }
    .services-grid { grid-template-columns: 1fr; }
    .services-title { font-size: 28px; }
  }
</style>
