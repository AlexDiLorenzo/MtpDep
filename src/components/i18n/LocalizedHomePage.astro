---
// Page d'accueil traduite (EN / ES) — gabarit unique, contenu par langue.
//
// Volontairement plus directe que la home française : le visiteur type
// est immobilisé au bord d'une route, souvent sur mobile et avec peu de
// batterie. Téléphone d'abord, procédure ensuite, réassurance après.

import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalizedNav from './LocalizedNav.astro';
import LocalizedFooter from './LocalizedFooter.astro';
import { site, photos } from '../../config/site';
import { agences } from '../../data/agences';
import { getContent, localeMeta, pathFor, type TranslatedLocale } from '../../i18n';
import { organizationSchema, faqPageSchema } from '../../lib/schema';

interface Props {
  locale: TranslatedLocale;
}

const { locale } = Astro.props;
const { ui, home, services } = getContent(locale);
const lang = localeMeta[locale].lang;

const servicesPath = pathFor('services', locale)!;
const coveragePath = pathFor('coverage', locale)!;

const jsonLd = [
  { ...organizationSchema(), inLanguage: lang },
  faqPageSchema(home.faq),
];
---

<BaseLayout
  title={home.title}
  description={home.description}
  locale={locale}
  routeKey="home"
  skipLabel={ui.skipToContent}
  jsonLd={jsonLd}
>
  <LocalizedNav locale={locale} routeKey="home" />

  <main id="main">
    {/* ============ HERO ============ */}
    <section class="lh-hero" style={`--lh-hero-bg: url('${photos.heroComedie}');`}>
      <div class="lh-hero-content">
        <div class="lh-pill">
          <span class="lh-pill-dot" aria-hidden="true"></span>
          {home.heroPill}
        </div>

        <h1 class="lh-title">
          {home.heroTitle}<br />
          <span class="lh-title-accent">{home.heroTitleAccent}</span>
        </h1>

        <p class="lh-lead">{home.heroLead}</p>

        <a href={site.phone.href} class="lh-phone" data-call-source={`${locale}-hero`}>
          <span class="lh-phone-icon" aria-hidden="true">☎</span>
          <span class="lh-phone-text">
            <span class="lh-phone-kicker">{ui.emergency}</span>
            <span class="lh-phone-number mono">{site.phone.display}</span>
          </span>
        </a>

        <ul class="lh-reassure">
          {home.heroReassure.map((r) => (
            <li><span class="lh-check" aria-hidden="true">✓</span> {r}</li>
          ))}
        </ul>
      </div>

      <div class="lh-trust">
        <ul class="lh-stats">
          {home.stats.map((s) => (
            <li class="lh-stat">
              <div class="lh-stat-value">{s.value}</div>
              <div class="lh-stat-label">{s.label}</div>
              <div class="lh-stat-kicker">{s.kicker}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ============ QUE FAIRE EN CAS DE PANNE ============ */}
    <section class="lh-section lh-section-alt">
      <div class="lh-inner">
        <div class="lh-overline">{home.breakdownOverline}</div>
        <h2 class="lh-h2">{home.breakdownHeading}</h2>
        <ol class="lh-steps">
          {home.breakdownSteps.map((s, i) => (
            <li class="lh-step">
              <span class="lh-step-num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="lh-step-title">{s.titre}</h3>
              <p class="lh-step-desc">{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ============ SERVICES ============ */}
    <section class="lh-section">
      <div class="lh-inner">
        <div class="lh-overline">{home.servicesOverline}</div>
        <h2 class="lh-h2">{home.servicesHeading}</h2>
        <p class="lh-lead-inline">{home.servicesLead}</p>

        <ul class="lh-services">
          {services.map((s) => (
            <li>
              <a href={`${servicesPath}${s.slug}/`} class="lh-service">
                <span class="lh-service-tag mono">{s.tag}</span>
                <h3 class="lh-service-title">{s.titre}</h3>
                <p class="lh-service-desc">{s.resume}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ============ POURQUOI NOUS ============ */}
    <section class="lh-section lh-section-alt">
      <div class="lh-inner">
        <div class="lh-overline">{home.trustOverline}</div>
        <h2 class="lh-h2">{home.trustHeading}</h2>
        <div class="lh-prose">
          {home.trustBody.map((p) => <p>{p}</p>)}
        </div>
        <ul class="lh-points">
          {home.trustPoints.map((p) => (
            <li class="lh-point">
              <h3 class="lh-point-title">{p.titre}</h3>
              <p class="lh-point-desc">{p.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ============ COUVERTURE ============ */}
    <section class="lh-section">
      <div class="lh-inner lh-coverage">
        <div>
          <div class="lh-overline">{home.coverageOverline}</div>
          <h2 class="lh-h2">{home.coverageHeading}</h2>
          <p class="lh-lead-inline">{home.coverageLead}</p>
          <a href={coveragePath} class="lh-link">
            {home.coverageCta} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="lh-depots">
          {agences.map((a) => (
            <li>
              <span class="lh-depot-name">{a.nomCourt}</span>
              <span class="lh-depot-city mono">{a.adresse.codePostal}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ============ FAQ ============ */}
    <section class="lh-section lh-section-alt">
      <div class="lh-inner">
        <h2 class="lh-h2">{ui.faqHeading}</h2>
        <div class="lh-faq">
          {home.faq.map((f) => (
            <details class="lh-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ============ CTA ============ */}
    <section class="lh-cta">
      <div class="lh-inner">
        <h2 class="lh-cta-title">{home.ctaTitle}</h2>
        <p class="lh-cta-lead">{home.ctaLead}</p>
        <a href={site.phone.href} class="lh-cta-phone" data-call-source={`${locale}-home-cta`}>
          <span aria-hidden="true">☎</span>
          <span class="mono">{site.phone.display}</span>
        </a>
      </div>
    </section>
  </main>

  <LocalizedFooter locale={locale} routeKey="home" />
</BaseLayout>

<style>
  /* ====== Hero ====== */
  .lh-hero {
    position: relative;
    min-height: 580px;
    background-image:
      linear-gradient(180deg, rgba(26,25,15,0.72) 0%, rgba(26,25,15,0.82) 100%),
      var(--lh-hero-bg);
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 80px var(--pad-x-desktop) 0;
  }
  .lh-hero-content { max-width: var(--container-max); margin: 0 auto; width: 100%; }
  .lh-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: rgba(228,225,60,0.16);
    border: 1px solid rgba(228,225,60,0.4);
    color: var(--md-brand-yellow);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .lh-pill-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--md-brand-yellow);
  }
  .lh-title {
    font-family: var(--font-display);
    font-size: 52px;
    line-height: 1.06;
    letter-spacing: var(--tr-display);
    font-weight: 700;
    color: #fff;
    margin: 0 0 18px;
    max-width: 820px;
  }
  .lh-title-accent { color: var(--md-brand-yellow); }
  .lh-lead {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    margin: 0 0 28px;
    max-width: 660px;
  }
  .lh-phone {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 26px;
    background: var(--md-brand-yellow);
    color: var(--md-brand-black);
    border-radius: var(--radius-lg);
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0,0,0,0.35);
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .lh-phone:hover { transform: translateY(-2px); }
  .lh-phone-icon { font-size: 24px; }
  .lh-phone-text { display: flex; flex-direction: column; }
  .lh-phone-kicker {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .lh-phone-number { font-size: 24px; font-weight: 700; line-height: 1.15; }

  .lh-reassure {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .lh-reassure li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,0.88);
  }
  .lh-check { color: var(--md-brand-yellow); font-weight: 700; }

  .lh-trust {
    max-width: var(--container-max);
    margin: 44px auto 0;
    width: 100%;
  }
  .lh-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,0.16);
  }
  .lh-stat { padding: 22px 20px; border-right: 1px solid rgba(255,255,255,0.12); }
  .lh-stat:last-child { border-right: none; }
  .lh-stat-value {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--md-brand-yellow);
    line-height: 1;
  }
  .lh-stat-label {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    margin-top: 6px;
  }
  .lh-stat-kicker { font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 2px; }

  /* ====== Sections ====== */
  .lh-section { padding: 64px var(--pad-x-desktop); background: var(--color-bg); }
  .lh-section-alt { background: var(--color-bg-subtle); }
  .lh-inner { max-width: var(--container-max); margin: 0 auto; }
  .lh-overline {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 16px;
  }
  .lh-h2 {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1.12;
    letter-spacing: var(--tr-display);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 16px;
    max-width: 780px;
  }
  .lh-lead-inline {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 28px;
    max-width: 720px;
  }
  .lh-prose { max-width: 760px; margin-bottom: 32px; }
  .lh-prose p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 16px;
  }
  .lh-link {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .lh-link:hover { text-decoration: underline; }

  /* ====== Étapes ====== */
  .lh-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .lh-step {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 24px;
  }
  .lh-step-num {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-primary-bg);
    padding: 4px 9px;
    border-radius: var(--radius-xs);
    margin-bottom: 12px;
  }
  .lh-step-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 8px;
  }
  .lh-step-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ====== Services ====== */
  .lh-services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .lh-service {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 22px;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: transform var(--dur-base) var(--ease-standard),
                box-shadow var(--dur-base) var(--ease-standard);
  }
  .lh-service:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .lh-service-tag {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    background: var(--md-brand-yellow);
    color: var(--md-brand-black);
    padding: 4px 8px;
    border-radius: var(--radius-xs);
    margin-bottom: 12px;
  }
  .lh-service-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 8px;
  }
  .lh-service-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ====== Points de réassurance ====== */
  .lh-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .lh-point {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--md-brand-green);
    border-radius: var(--radius-lg);
    padding: 20px 22px;
  }
  .lh-point-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 6px;
  }
  .lh-point-desc {
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ====== Couverture ====== */
  .lh-coverage {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .lh-depots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .lh-depots li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--color-border);
  }
  .lh-depots li:last-child { border-bottom: none; }
  .lh-depot-name { font-size: 14px; font-weight: 700; color: var(--color-text); }
  .lh-depot-city { font-size: 11px; color: var(--color-text-muted); }

  /* ====== FAQ ====== */
  .lh-faq { max-width: 820px; }
  .lh-faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: 16px 0;
  }
  .lh-faq-item summary {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .lh-faq-item summary::-webkit-details-marker { display: none; }
  .lh-faq-item summary::after {
    content: '+';
    color: var(--color-primary);
    font-weight: 700;
    flex-shrink: 0;
  }
  .lh-faq-item[open] summary::after { content: '−'; }
  .lh-faq-item p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 12px 0 0;
  }

  /* ====== CTA ====== */
  .lh-cta {
    padding: 60px var(--pad-x-desktop);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(228,225,60,0.12) 0%, transparent 60%),
      var(--md-brand-green);
    text-align: center;
  }
  .lh-cta-title {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 8px;
  }
  .lh-cta-lead { font-size: 15px; color: rgba(255,255,255,0.82); margin: 0 0 24px; }
  .lh-cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 30px;
    background: var(--md-brand-yellow);
    color: var(--md-brand-black);
    border-radius: var(--radius-lg);
    font-size: 22px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    transition: transform var(--dur-base) var(--ease-standard);
  }
  .lh-cta-phone:hover { transform: translateY(-2px); }

  /* ====== Responsive ====== */
  @media (max-width: 1023px) {
    .lh-hero { padding: 64px var(--pad-x-tablet) 0; min-height: 520px; }
    .lh-title { font-size: 38px; }
    .lh-section { padding: 52px var(--pad-x-tablet); }
    .lh-cta { padding: 52px var(--pad-x-tablet); }
    .lh-services { grid-template-columns: repeat(2, 1fr); }
    .lh-coverage { grid-template-columns: 1fr; gap: 28px; }
    .lh-stats { grid-template-columns: repeat(2, 1fr); }
    .lh-stat:nth-child(2) { border-right: none; }
  }
  @media (max-width: 639px) {
    .lh-hero { padding: 52px var(--pad-x-mobile) 0; }
    .lh-title { font-size: 30px; }
    .lh-lead { font-size: 15px; }
    .lh-section { padding: 44px var(--pad-x-mobile); }
    .lh-cta { padding: 44px var(--pad-x-mobile); }
    .lh-cta-title { font-size: 24px; }
    .lh-services, .lh-steps, .lh-points { grid-template-columns: 1fr; }
    .lh-stats { grid-template-columns: 1fr; }
    .lh-stat { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.12); }
    .lh-phone-number { font-size: 21px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lh-phone, .lh-service, .lh-cta-phone { transition: none; }
  }
</style>
