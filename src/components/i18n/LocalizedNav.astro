---
// En-tête des pages traduites (EN / ES).
//
// Distinct de TopNav.astro, dont les libellés et les liens sont français
// et dont la pill « MDP recrute » ne concerne qu'un public local.
// Ici on garde l'essentiel : marque, deux rubriques, langue, téléphone.

import LogoMark from '../LogoMark.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { site } from '../../config/site';
import { getContent, pathFor, type RouteKey, type TranslatedLocale } from '../../i18n';

interface Props {
  locale: TranslatedLocale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const { ui } = getContent(locale);

const links = [
  { label: ui.navServices, href: pathFor('services', locale)! },
  { label: ui.navCoverage, href: pathFor('coverage', locale)! },
];
---

<nav class="lnav">
  <div class="lnav-inner">
    <a href={pathFor('home', locale)!} class="lnav-brand" aria-label={`${site.name} — ${ui.navHome}`}>
      <LogoMark size={44} />
    </a>

    <ul class="lnav-links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>

    <div class="lnav-cta">
      <LanguageSwitcher current={locale} routeKey={routeKey} />
      <a href={site.phone.href} class="lnav-phone mono" data-call-source={`${locale}-nav`}>
        <span aria-hidden="true">☎</span> {site.phone.display}
      </a>
    </div>
  </div>
</nav>

<style>
  .lnav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,254,250,0.93);
    border-bottom: 1px solid rgba(44,97,38,0.1);
    backdrop-filter: blur(18px) saturate(145%);
    -webkit-backdrop-filter: blur(18px) saturate(145%);
    box-shadow: 0 6px 24px rgba(18,50,17,0.06);
  }
  .lnav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    min-height: 76px;
    padding: 10px var(--pad-x-desktop);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .lnav-brand { display: flex; align-items: center; flex-shrink: 0; filter: drop-shadow(0 4px 7px rgba(18,50,17,0.13)); }

  .lnav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lnav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    padding: 9px 13px;
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-standard), background-color var(--dur-fast) var(--ease-standard);
  }
  .lnav-links a:hover { color: var(--color-primary); background: var(--color-primary-bg); }

  .lnav-cta { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .lnav-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--md-brand-green);
    color: #fff;
    border-radius: var(--radius-xl);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(44,97,38,0.22);
  }
  .lnav-phone:hover { background: var(--md-forest-700, #234f1e); }

  @media (max-width: 767px) {
    .lnav-inner { padding: 12px var(--pad-x-mobile); gap: 12px; flex-wrap: wrap; }
    .lnav-links { order: 3; width: 100%; gap: 18px; }
    .lnav-phone { font-size: 13px; padding: 9px 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lnav-links a { transition: none; }
  }
</style>
