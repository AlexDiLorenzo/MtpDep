---
// En-tête léger réutilisé par les pages institutionnelles.
interface Props {
  overline: string;
  title: string;
  lead?: string;
}
const { overline, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-inner">
    <div class="page-hero-overline">{overline}</div>
    <h1 class="page-hero-title">{title}</h1>
    {lead && <p class="page-hero-lead">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding: 76px var(--pad-x-desktop) 66px;
    background:
      radial-gradient(circle at 82% -10%, rgba(228,225,60,0.16), transparent 38%),
      radial-gradient(circle at 8% 120%, rgba(100,161,66,0.2), transparent 36%),
      linear-gradient(135deg, #102F17 0%, #1E4B24 100%);
    border-bottom: 1px solid rgba(228,225,60,0.2);
    position: relative;
    overflow: hidden;
  }
  .page-hero::after {
    content: '';
    position: absolute;
    width: 330px;
    height: 330px;
    right: -110px;
    top: -180px;
    border: 1px solid rgba(228,225,60,0.16);
    border-radius: 50%;
    box-shadow: 0 0 0 55px rgba(228,225,60,0.025);
  }
  .page-hero-inner { max-width: var(--container-max); margin: 0 auto; position: relative; z-index: 1; }
  .page-hero-overline {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--md-brand-yellow);
    background: rgba(228,225,60,0.09);
    border: 1px solid rgba(228,225,60,0.17);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 16px;
  }
  .page-hero-title {
    font-family: var(--font-display);
    font-size: clamp(42px, 5vw, 58px);
    line-height: 1.08;
    letter-spacing: var(--tr-display);
    font-weight: 700;
    color: #fff;
    margin: 0;
    max-width: 860px;
  }
  .page-hero-lead {
    font-size: 17px;
    line-height: 1.68;
    color: rgba(255,255,255,0.74);
    margin: 20px 0 0;
    max-width: 700px;
  }

  @media (max-width: 1023px) {
    .page-hero { padding: 58px var(--pad-x-tablet) 50px; }
  }
  @media (max-width: 639px) {
    .page-hero { padding: 46px var(--pad-x-mobile) 40px; }
    .page-hero-title { font-size: 34px; }
    .page-hero-lead { font-size: 15px; }
  }
</style>
