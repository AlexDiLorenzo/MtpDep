---
import LogoMark from './LogoMark.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { zones } from '../data/zones';

const year = new Date().getFullYear();

// Colonnes du footer — liens vers les vraies pages de l'architecture.
const columns = [
  {
    title: 'Services',
    links: [
      ...services.map((s) => ({ label: s.nom, href: `/services/${s.slug}/` })),
      { label: 'Tous les services', href: '/services/' },
    ],
  },
  {
    title: 'Le réseau',
    links: [
      { label: 'Nos 8 agences', href: '/agences/' },
      { label: 'Zones d’intervention', href: '/depannage/' },
      { label: 'À propos', href: '/a-propos/' },
      { label: 'Certifications NF', href: '/certifications/' },
      { label: 'Recrutement', href: '/recrutement/' },
    ],
  },
  {
    title: 'Informations',
    links: [
      { label: 'CGV', href: '/cgv/' },
      { label: 'Mentions légales', href: '/mentions-legales/' },
    ],
  },
];
---

<footer class="footer" id="contact">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-brand-head">
          <LogoMark size={42} class="footer-logo" />
        </div>
        <address class="footer-address">
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}<br />
          <a href={site.phone.href} class="footer-phone mono">{site.phone.display}</a><br />
          <a href={site.email.href} class="footer-email">{site.email.display}</a>
        </address>
      </div>

      {columns.map((c) => (
        <div class="footer-col">
          <div class="footer-col-title">{c.title}</div>
          <ul>
            {c.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* Maillage sitewide vers les pages villes — profondeur de clic 1 depuis
        n'importe quelle page, sans alourdir la grille de colonnes. */}
    <nav class="footer-zones" aria-label="Villes desservies">
      <span class="footer-zones-label">Dépannage 24/7 à</span>
      <ul>
        {zones.map((z) => (
          <li><a href={`/depannage/${z.slug}/`}>{z.ville}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-meta">
      <span>© {year} {site.name} · Agréé autoroutes · Certifié NF Service</span>
      <span class="mono">24 / 7 · Intervention garantie</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background:
      radial-gradient(circle at 8% 0%, rgba(62,127,44,0.18), transparent 32%),
      linear-gradient(150deg, #111D12 0%, var(--md-brand-black) 72%);
    color: var(--md-stone-50);
    padding: 76px var(--pad-x-desktop) 28px;
    font-family: var(--font-sans);
  }
  .footer-inner { max-width: var(--container-max); margin: 0 auto; }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 50px;
  }

  .footer-brand-head {
    display: flex;
    align-items: center;
    margin-bottom: 18px;
  }
  .footer-brand :global(.footer-logo) {
    background: var(--md-stone-50);
    border-radius: 16px;
    padding: 8px 12px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.24);
  }
  .footer-address {
    font-size: 13px;
    line-height: 1.7;
    color: var(--md-stone-300);
    font-style: normal;
  }
  .footer-phone {
    color: var(--md-brand-yellow);
    text-decoration: none;
    font-weight: 700;
    display: inline-block;
    margin-top: 10px;
    font-size: 16px;
  }
  .footer-phone:hover { text-decoration: underline; }
  .footer-email {
    color: var(--md-stone-50);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding-block: 4px;
  }
  .footer-email:hover { text-decoration: underline; }

  .footer-col-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--md-stone-400);
    margin-bottom: 14px;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col a {
    color: var(--md-stone-200);
    font-size: 13px;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
    display: inline-block;
  }
  .footer-col a:hover { color: var(--md-brand-yellow); transform: translateX(3px); }

  /* Bande « villes desservies » */
  .footer-zones {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 10px;
    padding: 20px 0;
    border-top: 1px solid var(--md-stone-600);
    margin-bottom: 4px;
  }
  .footer-zones-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--md-stone-400);
    flex-shrink: 0;
  }
  .footer-zones ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-zones a {
    font-size: 12px;
    color: var(--md-stone-300);
    text-decoration: none;
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .footer-zones a:hover { color: var(--md-brand-yellow); border-color: rgba(228,225,60,0.28); }

  .footer-meta {
    border-top: 1px solid var(--md-stone-600);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 12px;
    color: var(--md-stone-400);
    flex-wrap: wrap;
  }

  @media (max-width: 1023px) {
    .footer { padding: 56px var(--pad-x-tablet) 24px; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }

  @media (max-width: 639px) {
    .footer { padding: 48px var(--pad-x-mobile) 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
