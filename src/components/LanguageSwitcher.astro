---
// Sélecteur de langue — rendu sur toutes les pages multilingues.
//
// Rôle SEO autant qu'ergonomique : ce sont ces liens qui permettent à
// Google de DÉCOUVRIR les versions EN/ES. Le hreflang confirme la relation
// entre deux pages, il ne remplace pas un lien explorable vers elles.
//
// Ne propose que les langues où la route existe réellement (availableLocales),
// et rend la langue courante en <span> plutôt qu'en lien mort.

import { availableLocales, pathFor, localeMeta, type Locale, type RouteKey } from '../i18n';

interface Props {
  /** Langue de la page courante. */
  current: Locale;
  /** Route dont on veut les équivalents. */
  routeKey: RouteKey;
  /** Variante d'affichage : sombre pour le pied de page. */
  tone?: 'light' | 'dark';
}

const { current, routeKey, tone = 'light' } = Astro.props;

const options = availableLocales(routeKey).map((locale) => ({
  locale,
  meta: localeMeta[locale],
  href: pathFor(routeKey, locale)!,
}));
---

{options.length > 1 && (
  <div class:list={['lang', `lang-${tone}`]}>
    <span class="lang-label sr-only">{localeMeta[current].label}</span>
    <ul>
      {options.map(({ locale, meta, href }) =>
        locale === current ? (
          <li>
            <span class="lang-current" aria-current="true" title={meta.label}>
              {meta.short}
            </span>
          </li>
        ) : (
          <li>
            {/* hreflang indique à Google la langue de la CIBLE du lien */}
            <a href={href} hreflang={meta.lang} lang={meta.lang} title={meta.label}>
              {meta.short}
            </a>
          </li>
        ),
      )}
    </ul>
  </div>
)}

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .lang ul {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 3px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }
  .lang a,
  .lang-current {
    display: block;
    padding: 4px 9px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard),
                color var(--dur-fast) var(--ease-standard);
  }

  /* Variante claire — en-tête */
  .lang-light a { color: var(--color-text-muted); }
  .lang-light a:hover {
    background: var(--color-primary-bg);
    color: var(--color-primary);
  }
  .lang-light .lang-current {
    background: var(--md-brand-green);
    color: #fff;
  }

  /* Variante sombre — pied de page */
  .lang-dark ul { border-color: var(--md-stone-600); }
  .lang-dark a { color: var(--md-stone-300); }
  .lang-dark a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--md-brand-yellow);
  }
  .lang-dark .lang-current {
    background: var(--md-brand-yellow);
    color: var(--md-brand-black);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang a { transition: none; }
  }
</style>
